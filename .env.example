# Example environment for Foyer. Every variable is commented out and shows its default (or an example value
# when it has no default). Copy this file to .env.local for `pnpm dev` and `pnpm start`, or pass the variables
# to the container. The full reference is docs/src/content/docs/configs/environment-variables.md.

# ---------------------------------------------------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------------------------------------------------

# Comma-separated hosts (with the port when it is not 80 or 443) allowed to reach Foyer. `*` disables the check.
# Unset allows only localhost:<PORT>, 127.0.0.1:<PORT> and [::1]:<PORT>.
# FOYER_ALLOWED_HOSTS=foyer.example.com,192.168.1.2:3000

# Path to the Nunjucks config template, relative to the working directory. The Docker image sets
# /app/config/foyer.config.jsonc.njk.
# FOYER_CONFIG_FILE=foyer.config.jsonc.njk

# Absolute URL users open Foyer at, with scheme and port when needed. Required when authentication is enabled.
# FOYER_EXTERNAL_URL=https://foyer.example.com

# `true` makes widget proxy requests use IPv4 only.
# FOYER_PROXY_DISABLE_IPV6=false

# Port the server listens on. `pnpm dev` and `pnpm start` read it before they load .env.local, so a value set only
# there is ignored; set it in the shell instead, for example `PORT=8080 pnpm dev`.
# PORT=3000

# Docker image only. Address the server binds to; the entrypoint falls back to 0.0.0.0 when IPv6 is unavailable.
# HOSTNAME=::

# Docker image only. User and group ID the server runs as.
# PUID=0
# PGID=0

# Folder for logs (logs/). Use an absolute path.
# FOYER_DATA_DIR=/tmp/foyer

# Folder that holds public/locales. The `foyer` command sets it; leave it unset otherwise.
# FOYER_APP_DIR=

# Docker image only. The entrypoint sets it to the container start time; leave it unset.
# FOYER_BUILDTIME=

# ---------------------------------------------------------------------------------------------------------------------
# Browser access (Content-Security-Policy)
# ---------------------------------------------------------------------------------------------------------------------

# `enforce`, `report-only` or `off`.
# FOYER_CSP=enforce

# Space or comma separated sources the iFrame widget may load.
# FOYER_CSP_FRAME_SRC=https://grafana.lan https://*.example.com:8443

# ---------------------------------------------------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------------------------------------------------

# `true` requires sign-in for the dashboard and API routes.
# FOYER_AUTH_ENABLED=false

# At least 32 random characters that sign and encrypt session cookies. Generate with `openssl rand -base64 32`.
# FOYER_AUTH_SECRET=

# Password for password login. Required unless the three OIDC variables below are set. In .env.local, wrap a password
# that contains `#` in double quotes, since an unquoted `#` starts a comment, and write each literal `$` as `\$`, since
# `$NAME` is replaced with the variable NAME even inside quotes.
# FOYER_AUTH_PASSWORD=

# Setting the issuer, client ID and client secret switches sign-in from password to OIDC.
# FOYER_OIDC_ISSUER=https://auth.example.com
# FOYER_OIDC_CLIENT_ID=
# FOYER_OIDC_CLIENT_SECRET=
# FOYER_OIDC_NAME=Foyer OIDC
# FOYER_OIDC_SCOPE=openid email profile

# `true` sends unauthenticated visitors straight to the OIDC provider.
# FOYER_OIDC_AUTO_LOGIN=false

# Take precedence over FOYER_AUTH_SECRET and FOYER_EXTERNAL_URL when set.
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=https://foyer.example.com/api/auth

# ---------------------------------------------------------------------------------------------------------------------
# MCP
# ---------------------------------------------------------------------------------------------------------------------

# `true` enables the /api/mcp endpoint.
# FOYER_MCP_ENABLED=false

# Bearer token for MCP clients, at least 32 characters. Required when FOYER_AUTH_ENABLED is not `true`.
# FOYER_MCP_TOKEN=

# ---------------------------------------------------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------------------------------------------------

# error, warn, info, http, verbose, debug or silly. `debug` logs full upstream URLs, secrets included.
# LOG_LEVEL=info

# stdout, file or both.
# LOG_TARGETS=both

# ---------------------------------------------------------------------------------------------------------------------
# Config template variables
# ---------------------------------------------------------------------------------------------------------------------

# Only variables whose names start with FOYER_VAR_ reach the config template, as {{ FOYER_VAR_<NAME> }}.
# A variable the template uses but that is not set fails the render.
# FOYER_VAR_PLEX_TOKEN=

# ---------------------------------------------------------------------------------------------------------------------
# Build time (read by `pnpm build`, the Docker build and `pnpm pack`; no effect on a running server)
# ---------------------------------------------------------------------------------------------------------------------

# Version, git revision and build time shown in the dashboard footer.
# NEXT_PUBLIC_VERSION=dev
# NEXT_PUBLIC_REVISION=dev
# NEXT_PUBLIC_BUILDTIME=

# `true` builds without the standalone output, for the npm package. `pnpm pack` sets it.
# FOYER_NPM_PACKAGE=

# Docker build only. `true` uses a prebuilt .next/standalone/ and .next/static/ from the build context.
# CI=

# Turns off Next.js telemetry. The pnpm scripts and the Dockerfile always set it.
# NEXT_TELEMETRY_DISABLED=1
