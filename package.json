{
    "name": "@arpanrec/foyer",
    "version": "0.0.6-rc0",
    "type": "module",
    "exports": {
        "./schema.json": "./src/foyer-config/foyer.schema.json",
        "./package.json": "./package.json"
    },
    "bin": {
        "foyer": "./dist/cli/foyer.js"
    },
    "files": [
        "dist/cli/",
        ".next/",
        "!.next/cache/",
        "!.next/dev/",
        "!.next/diagnostics/",
        "!.next/standalone/",
        "public/",
        "next.config.ts",
        "src/foyer-config/foyer.schema.json"
    ],
    "engines": {
        "node": "^22.18.0 || >=23.6.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.18.0",
            "onFail": "download"
        },
        "runtime": {
            "name": "node",
            "version": "26.13.0",
            "onFail": "download"
        }
    },
    "scripts": {
        "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
        "build": "NEXT_TELEMETRY_DISABLED=1 next build",
        "start": "NEXT_TELEMETRY_DISABLED=1 next start",
        "build:cli": "rm -rf dist && tsc -p tsconfig.cli.json",
        "prepack": "FOYER_NPM_PACKAGE=true NEXT_PUBLIC_VERSION=${NEXT_PUBLIC_VERSION:-$npm_package_version} NEXT_PUBLIC_BUILDTIME=${NEXT_PUBLIC_BUILDTIME:-$(date -u +%Y-%m-%dT%H:%M:%SZ)} NEXT_PUBLIC_REVISION=${NEXT_PUBLIC_REVISION:-$(git rev-parse HEAD 2>/dev/null)} pnpm build && node src/build/package-externals.ts && pnpm build:cli",
        "lint": "oxlint --type-aware .",
        "format": "oxfmt",
        "format:check": "oxfmt --check && prettier --check .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "docs:dev": "pnpm --filter @foyer/docs dev",
        "docs:build": "pnpm --filter @foyer/docs build",
        "telemetry": "next telemetry disable"
    },
    "dependencies": {
        "@cacheable/memory": "2.2.0",
        "@headlessui/react": "2.2.10",
        "@kubernetes/client-node": "2.0.2",
        "@nodable/entities": "3.1.0",
        "classnames": "2.5.1",
        "dockerode": "5.0.1",
        "fast-xml-parser": "5.12.0",
        "fast-xml-validator": "1.4.2",
        "follow-redirects": "1.16.2",
        "gamedig": "5.3.3",
        "i18next": "26.7.2",
        "ical.js": "2.2.1",
        "json-rpc-2.0": "1.8.1",
        "jsonc-parser": "3.3.1",
        "luxon": "3.7.2",
        "next": "16.4.5",
        "next-auth": "4.24.15",
        "next-i18next": "16.4.6",
        "nunjucks": "3.2.4",
        "ping": "1.0.0",
        "pretty-bytes": "7.2.0",
        "raw-body": "4.0.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-i18next": "17.1.13",
        "react-icons": "5.7.0",
        "recharts": "3.10.1",
        "sax": "1.6.1",
        "server-only": "0.0.1",
        "swr": "2.5.1",
        "systeminformation": "5.33.19",
        "tough-cookie": "6.1.0",
        "urbackup-server-api": "0.101.0",
        "winston": "3.19.0",
        "ws": "8.22.1"
    },
    "devDependencies": {
        "@coderabbitai/config": "1.1.6",
        "@tailwindcss/forms": "0.5.11",
        "@tailwindcss/postcss": "4.3.5",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@types/dockerode": "4.0.2",
        "@types/follow-redirects": "1.14.4",
        "@types/gamedig": "5.0.3",
        "@types/luxon": "3.7.6",
        "@types/node": "26.6.6",
        "@types/nunjucks": "3.2.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/sax": "1.2.7",
        "@types/ws": "8.18.2",
        "@vitest/coverage-v8": "5.1.0",
        "jsdom": "31.0.0",
        "oxfmt": "0.77.0",
        "oxlint": "1.92.0",
        "oxlint-tsgolint": "7.0.2006",
        "postcss": "8.5.32",
        "prettier": "3.9.10",
        "tailwindcss": "4.3.5",
        "typescript": "7.0.2",
        "vitest": "5.1.0"
    },
    "optionalDependencies": {
        "osx-temperature-sensor": "1.0.8"
    }
}
