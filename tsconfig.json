{
    "compilerOptions": {
        "target": "es2025",
        "lib": ["dom", "dom.iterable", "esnext"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "allowJs": false,
        "skipLibCheck": true,
        "strict": true,
        "strictNullChecks": true,
        "noEmit": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "incremental": true,
        "types": ["node", "react", "react-dom", "vitest/globals"],
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": [
        "next-env.d.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        ".next/types/**/*.ts",
        "*.ts",
        ".prettierrc.mts",
        ".next/dev/types/**/*.ts",
        ".next/dev/dev/types/**/*.ts"
    ],
    "exclude": ["node_modules", "src/skeleton"]
}
