---
// Replaces Starlight's default theme picker, a native <select>, with a custom listbox. On Linux, Chromium renders a
// native <select>'s option popup as an OS (GTK) widget outside the page's compositing layer, so it ignores the
// page's CSS entirely and never gets Foyer's frosted-glass look -- it stays flat and grey no matter what colours
// the <option> elements are given. A hand-built popup is a normal DOM element, so it can use the same
// backdrop-filter blur and --sl-color-bg-nav tint as the header and sidebar panels.
import { Icon } from "@astrojs/starlight/components";

const icons = { dark: "moon", light: "sun", auto: "laptop" } as const;
const order = ["dark", "light", "auto"] as const;
---

<starlight-theme-select class="foyer-theme-select">
    <button type="button" class="trigger" aria-haspopup="listbox" aria-expanded="false">
        <span class="sr-only">{Astro.locals.t("themeSelect.accessibleLabel")}</span>
        <Icon name="laptop" class="icon label-icon" />
        <span class="trigger-label">{Astro.locals.t("themeSelect.auto")}</span>
        <Icon name="down-caret" class="icon caret" />
    </button>
    <ul class="popup" role="listbox" hidden>
        {
            order.map((value) => (
                <li role="option" data-value={value} tabindex="-1" aria-selected={value === "auto" ? "true" : "false"}>
                    <Icon name={icons[value]} class="icon option-icon" />
                    {Astro.locals.t(`themeSelect.${value}`)}
                </li>
            ))
        }
    </ul>
</starlight-theme-select>

{/* Inlined and synchronous so the trigger label, icon and active option reflect the stored theme before first
    paint, same purpose as Starlight's own inline icon-swap script. */}
<script is:inline>
    (() => {
        const picker = document.currentScript?.previousElementSibling;
        if (!(picker instanceof HTMLElement) || picker.tagName !== "STARLIGHT-THEME-SELECT") return;
        const theme = (typeof localStorage !== "undefined" && localStorage.getItem("starlight-theme")) || "auto";
        const option = picker.querySelector(`li[data-value="${theme}"]`);
        if (!option) return;
        for (const li of picker.querySelectorAll('li[role="option"]')) {
            li.setAttribute("aria-selected", String(li === option));
        }
        const icon = picker.querySelector(".label-icon");
        const newIcon = option.querySelector(".option-icon");
        if (icon && newIcon) icon.replaceChildren(...newIcon.cloneNode(true).childNodes);
        const label = picker.querySelector(".trigger-label");
        if (label) label.textContent = option.textContent?.trim() ?? label.textContent;
    })();
</script>

<script>
    type Theme = "auto" | "dark" | "light";

    const storageKey = "starlight-theme";

    const parseTheme = (theme: unknown): Theme =>
        theme === "auto" || theme === "dark" || theme === "light" ? theme : "auto";

    const loadTheme = (): Theme =>
        parseTheme(typeof localStorage !== "undefined" && localStorage.getItem(storageKey));

    function storeTheme(theme: Theme): void {
        if (typeof localStorage !== "undefined") {
            localStorage.setItem(storageKey, theme === "light" || theme === "dark" ? theme : "");
        }
    }

    const getPreferredColorScheme = (): Theme =>
        matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";

    function applyTheme(theme: Theme): void {
        document.documentElement.dataset["theme"] = theme === "auto" ? getPreferredColorScheme() : theme;
    }

    class FoyerThemeSelect extends HTMLElement {
        #trigger: HTMLButtonElement;
        #popup: HTMLUListElement;
        #options: HTMLLIElement[];

        constructor() {
            super();
            const trigger = this.querySelector<HTMLButtonElement>(".trigger");
            const popup = this.querySelector<HTMLUListElement>(".popup");
            if (!trigger || !popup) throw new Error("FoyerThemeSelect: missing trigger or popup markup");
            this.#trigger = trigger;
            this.#popup = popup;
            this.#options = [...this.querySelectorAll<HTMLLIElement>('li[role="option"]')];

            this.#trigger.addEventListener("click", () => this.#toggle());
            this.#trigger.addEventListener("keydown", (event) => this.#onTriggerKeydown(event));
            this.#popup.addEventListener("keydown", (event) => this.#onPopupKeydown(event));
            document.addEventListener("click", (event) => {
                if (!this.contains(event.target as Node)) this.#close();
            });
            for (const option of this.#options) {
                option.addEventListener("click", () => this.#select(parseTheme(option.dataset["value"])));
            }

            document.addEventListener("foyer-theme-change", () => this.#render(loadTheme()));
            matchMedia("(prefers-color-scheme: light)").addEventListener("change", () => {
                if (loadTheme() === "auto") applyTheme("auto");
            });

            this.#render(loadTheme());
        }

        #toggle(): void {
            if (this.#popup.hidden) this.#open();
            else this.#close();
        }

        #open(): void {
            this.#popup.hidden = false;
            this.#trigger.setAttribute("aria-expanded", "true");
            const active = this.#options.find((option) => option.getAttribute("aria-selected") === "true");
            active?.focus();
        }

        #close(): void {
            this.#popup.hidden = true;
            this.#trigger.setAttribute("aria-expanded", "false");
        }

        #select(theme: Theme): void {
            storeTheme(theme);
            applyTheme(theme);
            this.#render(theme);
            this.#close();
            this.#trigger.focus();
            document.dispatchEvent(new CustomEvent("foyer-theme-change"));
        }

        #render(theme: Theme): void {
            const fallback = this.#options[this.#options.length - 1];
            const active = this.#options.find((option) => option.dataset["value"] === theme) ?? fallback;
            if (!active) return;
            for (const option of this.#options) {
                option.setAttribute("aria-selected", String(option === active));
            }
            const icon = this.querySelector(".label-icon");
            const newIcon = active.querySelector(".option-icon");
            if (icon && newIcon) icon.replaceChildren(...newIcon.cloneNode(true).childNodes);
            const label = this.querySelector(".trigger-label");
            if (label) label.textContent = active.textContent?.trim() ?? "";
        }

        #onTriggerKeydown(event: KeyboardEvent): void {
            if (event.key === "ArrowDown" || event.key === "Enter" || event.key === " ") {
                event.preventDefault();
                this.#open();
            }
        }

        #onPopupKeydown(event: KeyboardEvent): void {
            const currentIndex = this.#options.indexOf(document.activeElement as HTMLLIElement);
            if (event.key === "Escape") {
                event.preventDefault();
                this.#close();
                this.#trigger.focus();
            } else if (event.key === "ArrowDown") {
                event.preventDefault();
                this.#options[(currentIndex + 1) % this.#options.length]?.focus();
            } else if (event.key === "ArrowUp") {
                event.preventDefault();
                this.#options[(currentIndex - 1 + this.#options.length) % this.#options.length]?.focus();
            } else if (event.key === "Enter" || event.key === " ") {
                event.preventDefault();
                const option = this.#options[currentIndex];
                if (option) this.#select(parseTheme(option.dataset["value"]));
            }
        }
    }

    customElements.define("starlight-theme-select", FoyerThemeSelect);
</script>

<style>
    @layer starlight.core {
        .foyer-theme-select {
            position: relative;
            display: flex;
        }

        .trigger {
            --sl-label-icon-size: 0.875rem;
            --sl-caret-size: 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.25rem;
            border: 0;
            border-radius: 0.5rem;
            padding-block: 0.625rem;
            padding-inline: 0.5rem;
            margin-inline: -0.5rem;
            background-color: transparent;
            color: var(--sl-color-gray-2);
            font: inherit;
            cursor: pointer;
            transition:
                background-color 0.15s ease,
                color 0.15s ease;
        }

        .trigger:hover,
        .trigger[aria-expanded="true"] {
            background-color: hsla(0, 0%, 100%, 0.08);
            color: var(--sl-color-white);
        }

        .label-icon {
            font-size: var(--sl-label-icon-size);
        }

        .caret {
            font-size: var(--sl-caret-size);
            transition: transform 0.15s ease;
        }

        .trigger[aria-expanded="true"] .caret {
            transform: rotate(180deg);
        }

        @media (min-width: 50rem) {
            .trigger {
                font-size: var(--sl-text-sm);
            }
        }

        .popup {
            position: absolute;
            top: calc(100% + 0.5rem);
            inset-inline-end: 0;
            z-index: 10;
            margin: 0;
            padding: 0.25rem;
            min-width: 8rem;
            list-style: none;
            background-color: var(--sl-color-bg-nav);
            backdrop-filter: var(--foyer-blur);
            -webkit-backdrop-filter: var(--foyer-blur);
            border: 1px solid var(--sl-color-hairline);
            border-radius: 0.5rem;
            box-shadow: 0 0.5rem 1.5rem hsla(0, 0%, 0%, 0.35);
        }

        .popup li {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 0.625rem;
            border-radius: 0.375rem;
            color: var(--sl-color-gray-1);
            cursor: pointer;
        }

        .popup li:hover {
            background-color: hsla(0, 0%, 100%, 0.1);
        }

        .popup li:focus-visible {
            outline: 2px solid var(--sl-color-accent);
            outline-offset: -2px;
        }

        .popup li[aria-selected="true"] {
            background-color: var(--sl-color-accent);
            color: var(--sl-color-text-invert);
        }
    }
</style>
